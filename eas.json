{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "env": {
          "EXPO_PUSH_NOTIFICATIONS": "true",
          "EXPO_USE_FCM": "false",
          "EXPO_ENABLE_NEW_ARCHITECTURE": "true",
          "NODE_ENV": "development",
          "EXPO_PUBLIC_API_URL": "https://prod-admin.yes-charge.com/backend/v1"
        },
        "withoutCredentials": false
      },
      "ios": {
        "simulator": true,
        "distribution": "internal",
        "credentialsSource": "remote",
        "env": {
          "NODE_ENV": "development",
          "EXPO_PUBLIC_API_URL": "https://prod-admin.yes-charge.com/backend/v1"
        }
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote",
        "env": {
          "EXPO_PUSH_NOTIFICATIONS": "true",
          "EXPO_USE_FCM": "false",
          "EXPO_ENABLE_NEW_ARCHITECTURE": "true",
          "NODE_ENV": "production",
          "EXPO_PUBLIC_API_URL": "https://prod-admin.yes-charge.com/backend/v1"
        }
      },
      "ios": {
        "simulator": false,
        "distribution": "store",
        "credentialsSource": "remote",
        "env": {
          "NODE_ENV": "production",
          "EXPO_PUBLIC_API_URL": "https://prod-admin.yes-charge.com/backend/v1"
        }
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "mnomankohistani@gmail.com",
        "ascAppId": "6762475877"
      }
    }
  },
  "cli": {
    "appVersionSource": "local",
    "requireCommit": false,
    "promptToConfigurePushNotifications": false
  }
}
